{
  "name": "the-big-war",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "libs/*"],
  "scripts": {
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "preview": "bun run --cwd apps/client preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bun libs/linter/src/cli.ts apps libs",
    "lint:fix": "bun libs/linter/src/cli.ts apps libs --fix"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
